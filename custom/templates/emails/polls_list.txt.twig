 #
 # Change: adds the instance signature at the end of the e-mail.
 # "Best regards" has no translation key of its own upstream, so the text
 # stays in English whatever the recipient's language. appName is a global
 # Twig variable, bound to APP_NAME in .env.
 #}
{{ 'emails.polls_list.here_is_the_list' | trans({ appName: appName }) }}

{% for poll in polls %}
- {{ poll.title }} : {{ url('poll admin', { id: poll.id, token: poll.adminToken }) }}
{% endfor %}

Best regards,
{{ appName }} Team
