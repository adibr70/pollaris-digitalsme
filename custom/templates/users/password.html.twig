{% extends 'modal.html.twig' %}

{% block title %}{{ 'password.set_for' | trans({ username: user.userIdentifier }, 'digitalsme') }}{% endblock %}

{% block body %}
    {{ form_start(form, { action: path('change user password', { id: user.id }) }) }}
        {{ form_errors(form) }}
        {{ form_row(form.password.first) }}
        {{ form_row(form.password.second) }}

        <p class="text--secondary">
            {{ 'password.tell_them' | trans({}, 'digitalsme') }}
        </p>

        {{ form_row(form.submit) }}
    {{ form_end(form) }}
{% endblock %}
