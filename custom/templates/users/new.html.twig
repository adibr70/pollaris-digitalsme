{% extends 'modal.html.twig' %}

{% block title %}{{ 'users.add' | trans({}, 'digitalsme') }}{% endblock %}

{% block body %}
    {{ form_start(form, { action: path('new user') }) }}
        {{ form_errors(form) }}
        {{ form_row(form.username) }}
        {{ form_row(form.password) }}
        {{ form_row(form.administrator) }}
        {{ form_row(form.submit) }}
    {{ form_end(form) }}
{% endblock %}
