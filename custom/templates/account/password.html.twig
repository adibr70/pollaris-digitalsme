{% extends 'base.html.twig' %}

{% block title %}{{ 'password.title' | trans({}, 'digitalsme') }}{% endblock %}

{% block body %}
    <div class="wrapper wrapper--center flow flow--larger">
        <h1>{{ 'password.title' | trans({}, 'digitalsme') }}</h1>

        <div class="flow flow--large">
            <p class="text--secondary">
                {{ 'password.intro' | trans({ username: app.user.userIdentifier }, 'digitalsme') }}
            </p>

            {{ form_start(form, { action: path('my password') }) }}
                {{ form_errors(form) }}
                {{ form_row(form.current_password) }}
                {{ form_row(form.password.first) }}
                {{ form_row(form.password.second) }}
                {{ form_row(form.submit) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
